[colors]
background = #050306
background-alt = #130918
foreground = #cfc6d2
foreground-bright = #eee8f0
dim = #746a79
purple = #6a3c7d
purple-hi = #9a66b5
separator = #2a1631
alert = #ad6079


[bar/main]
monitor = eDP-1

bottom = true
width = 100%
height = 24pt
fixed-center = false

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 2pt
border-size = 0

padding-left = 1
padding-right = 1
module-margin = 1

separator = " "
separator-foreground = ${colors.separator}

font-0 = "Terminus (TTF):style=Medium:size=11;2"

modules-left = launcher i3
modules-center = title
modules-right = wlan cpu memory temperature fs-root fs-data pulseaudio battery profile date tray

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true
wm-restack = i3


[module/launcher]
type = custom/text

label = MENU
label-padding = 1
label-foreground = ${colors.purple-hi}

click-left = rofi -show drun


[module/i3]
type = internal/i3

pin-workspaces = true
show-urgent = true
index-sort = true

enable-click = true
enable-scroll = false

format = <label-state> <label-mode>

label-focused = %index%
label-focused-foreground = ${colors.foreground-bright}
label-focused-background = ${colors.purple}
label-focused-padding = 2

label-unfocused = %index%
label-unfocused-foreground = ${colors.dim}
label-unfocused-padding = 2

label-visible = %index%
label-visible-foreground = ${colors.foreground}
label-visible-background = ${colors.background-alt}
label-visible-padding = 2

label-urgent = %index%
label-urgent-foreground = ${colors.foreground-bright}
label-urgent-background = ${colors.alert}
label-urgent-padding = 2

label-mode = %mode%
label-mode-foreground = ${colors.foreground-bright}
label-mode-background = ${colors.background-alt}
label-mode-padding = 1


[module/title]
type = internal/xwindow

label = %title%
label-maxlen = 42
label-empty = desktop
label-empty-foreground = ${colors.dim}

format-padding = 1


[module/wlan]
type = internal/network

interface = wlp0s20f3
interval = 3

format-connected = <label-connected>
format-disconnected = <label-disconnected>

label-connected = %{F#9a66b5}NET%{F-} %essid% %signal%%
label-disconnected = %{F#ad6079}NET%{F-} down


[module/cpu]
type = internal/cpu

interval = 2
warn-percentage = 90

label = %{F#9a66b5}CPU%{F-} %percentage%%
label-warn = %{F#ad6079}CPU%{F-} %percentage%%


[module/memory]
type = internal/memory

interval = 2
warn-percentage = 90

label = %{F#9a66b5}MEM%{F-} %gb_used%/%gb_total%G
label-warn = %{F#ad6079}MEM%{F-} %gb_used%/%gb_total%G


[module/temperature]
type = internal/temperature

interval = 2
zone-type = x86_pkg_temp
warn-temperature = 85

label = %{F#9a66b5}TEMP%{F-} %temperature-c%
label-warn = %{F#ad6079}TEMP%{F-} %temperature-c%


[fs-base]
type = internal/fs

interval = 30
fixed-values = true
warn-percentage = 90

format-mounted = <label-mounted>
format-unmounted = <label-unmounted>

label-unmounted-foreground = ${colors.alert}


[module/fs-root]
inherit = fs-base

mount-0 = /
label-mounted = %{F#9a66b5}OS%{F-} %free%
label-unmounted = %{F#ad6079}OS%{F-} down


[module/fs-data]
inherit = fs-base

mount-0 = /home/ali/Data
label-mounted = %{F#9a66b5}DATA%{F-} %free%
label-unmounted = %{F#ad6079}DATA%{F-} down


[module/pulseaudio]
type = internal/pulseaudio

use-ui-max = false
interval = 5

format-volume = <label-volume>
format-muted = <label-muted>

label-volume = %{F#9a66b5}VOL%{F-} %percentage%%
label-muted = %{F#ad6079}VOL%{F-} mute

click-left = #pulseaudio.toggle
click-right = pavucontrol
scroll-up = #pulseaudio.inc
scroll-down = #pulseaudio.dec


[module/battery]
type = internal/battery

battery = BAT0
adapter = AC

full-at = 100
low-at = 15
poll-interval = 5

format-charging = <label-charging>
format-discharging = <label-discharging>
format-full = <label-full>
format-low = <label-low>

label-charging = %{F#9a66b5}BAT%{F-} +%percentage%%
label-discharging = %{F#9a66b5}BAT%{F-} %percentage%%
label-full = %{F#9a66b5}BAT%{F-} %percentage%%
label-low = %{F#ad6079}BAT%{F-} %percentage%%


[module/profile]
type = custom/script

exec = /home/ali/.local/bin/platform-profile-status
interval = 5

label = %{F#9a66b5}MODE%{F-} %output%

click-left = /home/ali/.local/bin/platform-profile-menu &


[module/date]
type = internal/date

interval = 5

date = %a %b %d  %H:%M
label = %date%


[module/tray]
type = internal/tray

format-margin = 4px

tray-size = 65%
tray-padding = 1px
tray-spacing = 5px
tray-background = ${colors.background}


[settings]
screenchange-reload = true
pseudo-transparency = true
