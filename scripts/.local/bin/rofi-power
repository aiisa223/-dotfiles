#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
    printf '%s\n' \
        'Lock' \
        'Logout i3' \
        'Suspend' \
        'Reboot' \
        'Power Off'
    exit 0
fi

case "$1" in
    'Lock')
        if command -v loginctl >/dev/null 2>&1; then
            loginctl lock-session
        elif command -v i3lock >/dev/null 2>&1; then
            i3lock
        fi
        ;;
    'Logout i3')
        i3-msg exit >/dev/null
        ;;
    'Suspend')
        systemctl suspend
        ;;
    'Reboot')
        systemctl reboot
        ;;
    'Power Off')
        systemctl poweroff
        ;;
esac
