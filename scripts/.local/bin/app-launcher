#!/usr/bin/env bash
set -euo pipefail

THEME="$HOME/.config/rofi/superd.rasi"
ACTIONS="$HOME/.local/bin/rofi-actions"

args=(
  -replace
  -show combi
  -matching fuzzy
  -sort
  -sorting-method fzf
  -case-smart
  -show-icons
  -theme "$THEME"
)

help="$(rofi -help 2>&1 || true)"

if grep -q -- '-combi-hide-mode-prefix' <<<"$help"; then
  args+=(-combi-hide-mode-prefix)
fi

if grep -q -- '-combi-modes' <<<"$help"; then
  exec rofi \
    -modes "combi,drun,Actions:$ACTIONS" \
    -combi-modes "drun,Actions" \
    "${args[@]}"
else
  exec rofi \
    -modi "combi,drun,Actions:$ACTIONS" \
    -combi-modi "drun,Actions" \
    "${args[@]}"
fi
