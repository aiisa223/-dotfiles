#!/usr/bin/env python3

import html
import json
import subprocess
import sys
from pathlib import Path


SOUND = "/usr/share/sounds/freedesktop/stereo/complete.oga"
INDICANT_REPO = "/home/ali/Data/work/projects/velos_monitor"


def spawn(argv: list[str]) -> None:
    """Launch a desktop-side effect without delaying or failing Codex."""
    try:
        subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    except OSError:
        pass


def compact(text: str, limit: int = 260) -> str:
    text = " ".join(text.split())
    if len(text) > limit:
        text = text[: limit - 1].rstrip() + "…"
    return text


def main() -> int:
    if len(sys.argv) != 2:
        return 0

    try:
        notification = json.loads(sys.argv[1])
    except (json.JSONDecodeError, TypeError):
        return 0

    if notification.get("type") != "agent-turn-complete":
        return 0

    cwd = str(notification.get("cwd") or "")
    response = compact(
        str(notification.get("last-assistant-message") or "Task complete.")
    )

    if cwd == INDICANT_REPO or cwd.startswith(INDICANT_REPO + "/"):
        title = "Codex · Indicant"
    elif cwd:
        title = f"Codex · {Path(cwd).name}"
    else:
        title = "Codex"

    # Escape assistant text because notification daemons may interpret markup.
    body = html.escape(response)

    spawn(
        [
            "/usr/bin/notify-send",
            "--app-name=Codex",
            "--urgency=normal",
            "--expire-time=12000",
            "--icon=dialog-information",
            title,
            body,
        ]
    )

    if Path(SOUND).is_file():
        spawn(["/usr/bin/pw-play", SOUND])

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
