#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
    up) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    *) exit 2 ;;
esac
state=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
value=$(awk '{printf "%.0f", $2 * 100}' <<< "$state")
if [[ "$state" == *MUTED* ]]; then
    value=0; label=Muted
else
    label="${value}%"
fi
dunstify -a osd -h string:x-dunst-stack-tag:volume -h int:value:"$value" AUDIO "$label"
