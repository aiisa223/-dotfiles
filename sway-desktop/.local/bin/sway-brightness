#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    up)
        brightnessctl --class=backlight set +5% >/dev/null
        ;;
    down)
        brightnessctl --class=backlight --min-value=1 set 5%- >/dev/null
        ;;
    *)
        exit 2
        ;;
esac

value="$(
    brightnessctl --class=backlight -m |
    awk -F, 'NR == 1 {
        gsub(/%/, "", $4)
        print $4
    }'
)"

dunstify \
    -a osd \
    -h string:x-dunst-stack-tag:brightness \
    -h int:value:"$value" \
    "BRIGHTNESS" \
    "${value}%"
