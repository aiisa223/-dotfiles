[global]
    monitor = 0
    follow = none
    width = 400
    height = 300
    origin = top-right
    offset = 14x14
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 320

    indicate_hidden = yes
    transparency = 0
    separator_height = 1
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 1
    frame_color = "#3c3836"
    separator_color = frame
    sort = yes

    font = DejaVu Sans Mono 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    icon_position = left
    min_icon_size = 28
    max_icon_size = 46

    sticky_history = yes
    history_length = 30
    corner_radius = 0

[urgency_low]
    background = "#282828"
    foreground = "#aaa69b"
    frame_color = "#3c3836"
    timeout = 4

[urgency_normal]
    background = "#282828"
    foreground = "#c8c3b7"
    frame_color = "#3c3836"
    timeout = 6

[urgency_critical]
    background = "#282828"
    foreground = "#c8c3b7"
    frame_color = "#bdae93"
    timeout = 0

[osd]
    appname = osd
    background = "#282828"
    foreground = "#c8c3b7"
    frame_color = "#928374"
    timeout = 2
