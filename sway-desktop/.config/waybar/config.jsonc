{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 8,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "network",
    "wireplumber",
    "backlight",
    "battery",
    "tray",
    "clock",
    "custom/session"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "{}"
  },
  "sway/window": {
    "max-length": 45,
    "separate-outputs": true
  },
  "network": {
    "format-wifi": "WiFi {signalStrength}%",
    "format-ethernet": "LAN",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "kitty nmtui"
  },
  "wireplumber": {
    "format": "VOL {volume}%",
    "format-muted": "Muted",
    "on-click": "~/.local/bin/sway-volume mute",
    "on-scroll-up": "~/.local/bin/sway-volume up",
    "on-scroll-down": "~/.local/bin/sway-volume down"
  },
  "backlight": {
    "format": "BRT {percent}%",
    "on-scroll-up": "~/.local/bin/sway-brightness up",
    "on-scroll-down": "~/.local/bin/sway-brightness down"
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "BAT {capacity}%",
    "format-charging": "AC {capacity}%",
    "format-plugged": "AC {capacity}%",
    "tooltip-format": "{timeTo}"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d}"
  },
  "custom/session": {
    "format": "Session",
    "tooltip": false,
    "on-click": "~/.local/bin/sway-power-menu"
  },
  "tray": {
    "spacing": 8
  }
}
