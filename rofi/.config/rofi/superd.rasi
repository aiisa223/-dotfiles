* {
    bg:      #050607;
    surface: #0B0D10;
    hover:   #12151A;
    line:    #20242A;
    fg:      #F1F3F5;
    fg2:     #A5AAB1;
    fg3:     #676D76;
    focus:   #8297FF;
    warning: #E46C78;
    font: "IBM Plex Sans 11";
}

window {
    location: center;
    anchor: center;
    width: 660px;
    background-color: @bg;
    border: 1px;
    border-color: @line;
    border-radius: 4px;
}

mainbox {
    background-color: transparent;
    padding: 0px;
    spacing: 0px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface;
    padding: 14px 16px;
    spacing: 0px;
    children: [ entry ];
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search apps, files, settings and actions…";
    placeholder-color: @fg3;
}

listview {
    background-color: transparent;
    lines: 9;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    cycle: true;
    scrollbar: false;
    spacing: 2px;
    padding: 7px;
}

element {
    background-color: transparent;
    text-color: @fg2;
    padding: 8px 10px;
    spacing: 12px;
    border: 0px;
    border-radius: 3px;
    children: [ element-icon, element-text ];
}

element-icon {
    background-color: transparent;
    size: 25px;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg2;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal,
element selected.active {
    background-color: @hover;
    text-color: @fg;
}

element selected.urgent {
    background-color: @hover;
    text-color: @warning;
}
