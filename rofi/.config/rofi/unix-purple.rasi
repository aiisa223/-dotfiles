* {
    bg:       #050306;
    bg-alt:   #130918;
    fg:       #cfc6d2;
    dim:      #746a79;
    purple:   #6a3c7d;
    purple-hi:#9a66b5;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 42%;
    border: 2px;
    border-color: @purple;
    background-color: @bg;
    padding: 8px;
}

mainbox {
    background-color: @bg;
    spacing: 6px;
}

inputbar {
    background-color: @bg-alt;
    text-color: @fg;
    padding: 6px;
    spacing: 8px;
}

prompt {
    text-color: @purple-hi;
}

entry {
    text-color: @fg;
}

listview {
    background-color: @bg;
    lines: 10;
    spacing: 1px;
    scrollbar: false;
}

element {
    background-color: @bg;
    text-color: @fg;
    padding: 4px 6px;
}

element selected.normal {
    background-color: @purple;
    text-color: #eee8f0;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}
