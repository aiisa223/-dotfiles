# Rendering
backend = "glx";
vsync = true;
use-damage = true;

# Crisp X11 workstation appearance
corner-radius = 0;

# Keep windows fully opaque
active-opacity = 1.0;
inactive-opacity = 1.0;
frame-opacity = 1.0;

# Restrained depth without modern blur/glass effects
shadow = true;
shadow-radius = 5;
shadow-opacity = 0.22;
shadow-offset-x = -3;
shadow-offset-y = -3;
shadow-color = "#000000";

# Very short transitions
fading = true;
fade-delta = 8;
fade-in-step = 0.12;
fade-out-step = 0.12;

# Don't shadow panels/desktop-type surfaces
shadow-exclude = [
    "window_type = 'dock'",
    "window_type = 'desktop'"
];
